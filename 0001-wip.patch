+package org.apache.cassandra.distributed.test;
+
+import java.net.InetSocketAddress;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.Callable;
+import java.util.function.Consumer;
+
+import com.google.common.collect.Iterables;
+import org.junit.Test;
+
+import com.datastax.driver.core.PlainTextAuthProvider;
+import com.datastax.driver.core.Session;
+import com.datastax.driver.core.policies.DCAwareRoundRobinPolicy;
+import org.apache.cassandra.auth.AuthenticatedUser;
+import org.apache.cassandra.auth.CassandraRoleManager;
+import org.apache.cassandra.auth.DataResource;
+import org.apache.cassandra.auth.Permission;
+import org.apache.cassandra.config.SchemaConstants;
+import org.apache.cassandra.db.ColumnFamilyStore;
+import org.apache.cassandra.db.Keyspace;
+import org.apache.cassandra.distributed.Cluster;
+import org.apache.cassandra.distributed.api.Feature;
+import org.apache.cassandra.distributed.api.IInvokableInstance;
+import org.apache.cassandra.distributed.api.IIsolatedExecutor;
+import org.apache.cassandra.distributed.api.IIsolatedExecutor.SerializableQuadFunction;
+import org.apache.cassandra.distributed.api.TokenSupplier;
+import org.apache.cassandra.service.ClientState;
+import org.apache.cassandra.service.StorageService;
+import org.apache.cassandra.utils.FBUtilities;
+
+import static com.google.common.collect.ImmutableSet.of;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+public class GrantTest extends TestBaseImpl
+{
+    @Test
+    public void testProtectedResources() throws Throwable
+    {
+        Map<String, Object> config = new HashMap<>();
+        config.put("authenticator", "org.apache.cassandra.auth.PasswordAuthenticator");
+        config.put("authorizer", "org.apache.cassandra.auth.CassandraAuthorizer");
+        config.put("role_manager", "org.apache.cassandra.auth.CassandraRoleManager");
+        config.put("permissions_validity_in_ms", 0);
+        config.put("roles_validity_in_ms", 0);
+
+        try (Cluster cluster = Cluster.build()
+                                      .withDCs(1)
+                                      .withNodes(1)
+                                      .withTokenSupplier(TokenSupplier.evenlyDistributedTokens(1, 1))
+                                      .withConfig(c -> {
+                                          config.forEach(c::set);
+                                          c.with(Feature.GOSSIP, Feature.NETWORK, Feature.NATIVE_PROTOCOL);
+                                      })
+                                      .start())
+        {
+            waitFor(() -> cluster.get(1).callOnInstance(CassandraRoleManager::hasExistingRoles));
+            waitFor(() -> cluster.get(1).callOnInstance(() -> StorageService.instance.isAuthSetupComplete()));
+
+            IInvokableInstance instance = cluster.get(1);
+
+            doWithSession(s -> s.execute("CREATE ROLE auser WITH PASSWORD = '123' AND LOGIN = true"));
+
+            Map<String, Set<String>> systemTables = getSystemTables(instance);
+            ensurePermission(instance, systemTables, of(), of(), of());
+
+            doWithSession(s -> s.execute("GRANT ALTER ON ALL KEYSPACES TO auser"));
+            ensurePermission(instance, systemTables, of(), of(), of("ALL_KEYSPACES"));
+
+            doWithSession(s -> s.execute("GRANT ALTER ON KEYSPACE system_auth TO auser"));
+            ensurePermission(instance, systemTables, of("system_auth"), of(), of("ALL_KEYSPACES", "KEYSPACE"));
+
+            doWithSession(s -> s.execute("REVOKE ALTER ON ALL KEYSPACES FROM auser"));
+            doWithSession(s -> s.execute("REVOKE ALTER ON KEYSPACE system_auth FROM auser"));
+
+            doWithSession(s -> s.execute("GRANT SELECT ON TABLE system_auth.roles TO auser"));
+            ensurePermission(instance, systemTables, of(), of("system_auth.roles"), of("TABLE"));
+
+            doWithSession(s -> s.execute("REVOKE SELECT ON TABLE system_auth.roles FROM auser"));
+            ensurePermission(instance, systemTables, of(), of(), of());
+        }
+    }
+
+    private static ClientState makeFakeClientState()
+    {
+        return ClientState.forExternalCalls(new InetSocketAddress(FBUtilities.getBroadcastAddress(), 9042));
+    }
+
+    private void ensurePermission(IInvokableInstance instance,
+                                  Map<String, Set<String>> systemTables,
+                                  Set<String> permittedKeyspaces,
+                                  Set<String> permittedTables,
+                                  Set<String> levels)
+    {
+        instance.applyOnInstance((SerializableQuadFunction<Map<String, Set<String>>, Set<String>, Set<String>, Set<String>, Void>)
+                                 (systemTbl, permittedKs, permittedTbls, lvls) -> {
+
+                                     ClientState state = makeFakeClientState();
+                                     state.login(new AuthenticatedUser("auser"));
+
+                                     // populate all data resources of tables
+                                     Set<DataResource> tableDataResources = new HashSet<>();
+                                     for (Map.Entry<String, Set<String>> entry : systemTbl.entrySet())
+                                     {
+                                         for (String table : entry.getValue())
+                                             tableDataResources.add(DataResource.table(entry.getKey(), table));
+                                     }
+
+                                     Set<DataResource> keyspaceDataResources = new HashSet<>();
+                                     for (String keyspace : systemTbl.keySet())
+                                         keyspaceDataResources.add(DataResource.keyspace(keyspace));
+
+                                     for (DataResource resource : Iterables.concat(keyspaceDataResources, tableDataResources))
+                                     {
+                                         for (Permission permission : Permission.ALL)
+                                         {
+                                             if (of(Permission.CREATE, Permission.ALTER, Permission.DROP).contains(permission))
+                                             {
+                                                 if (SchemaConstants.isLocalSystemKeyspace(resource.getKeyspace()))
+                                                 {
+                                                     assertThatThrownBy(() -> state.hasAccess(resource.getKeyspace(), permission, resource),
+                                                                        String.format("Expected error for %s on %s", resource.getKeyspace(), permission))
+                                                     .isInstanceOf(org.apache.cassandra.exceptions.UnauthorizedException.class);
+                                                 }
+                                                 else if (SchemaConstants.isReplicatedSystemKeyspace(resource.getKeyspace()))
+                                                 {
+                                                     if (permission == Permission.ALTER && resource.isKeyspaceLevel())
+                                                     {
+                                                         if (!lvls.containsAll(of("ALL_KEYSPACES", "KEYSPACE")))
+                                                         {
+                                                             assertThatThrownBy(() -> state.hasAccess(resource.getKeyspace(), permission, resource),
+                                                                                String.format("Expected error for %s on %s", resource.getKeyspace(), permission))
+                                                             .isInstanceOf(org.apache.cassandra.exceptions.UnauthorizedException.class);
+                                                         }
+                                                         else
+                                                         {
+                                                             if (permittedKs.contains(resource.getKeyspace()))
+                                                             {
+                                                                 state.hasAccess(resource.getKeyspace(), permission, resource);
+                                                             }
+                                                             else
+                                                             {
+                                                                 assertThatThrownBy(() -> state.hasAccess(resource.getKeyspace(), permission, resource),
+                                                                                    String.format("Expected error for %s on %s", resource.getKeyspace(), permission))
+                                                                 .isInstanceOf(org.apache.cassandra.exceptions.UnauthorizedException.class);
+                                                             }
+                                                         }
+                                                     }
+                                                     else
+                                                     {
+                                                         assertThatThrownBy(() -> state.hasAccess(resource.getKeyspace(), permission, resource),
+                                                                            String.format("Expected error for %s on %s", resource.getKeyspace(), permission))
+                                                         .isInstanceOf(org.apache.cassandra.exceptions.UnauthorizedException.class);
+                                                     }
+                                                 }
+                                             }
+                                             else if (permission == Permission.MODIFY)
+                                             {
+                                                 assertThatThrownBy(() -> state.hasAccess(resource.getKeyspace(), permission, resource),
+                                                                    String.format("Expected error for %s on %s", resource.getKeyspace(), permission))
+                                                 .isInstanceOf(org.apache.cassandra.exceptions.UnauthorizedException.class);
+                                             }
+                                             else if (permission == Permission.SELECT)
+                                             {
+                                                 if (resource.isTableLevel())
+                                                 {
+                                                     if (!ClientState.READABLE_SYSTEM_RESOURCES.contains(DataResource.table(resource.getKeyspace(), resource.getTable())))
+                                                     {
+                                                         if (!lvls.equals(of("TABLE")))
+                                                         {
+                                                             assertThatThrownBy(() -> state.hasAccess(resource.getKeyspace(), permission, resource),
+                                                                                String.format("Expected error for %s on %s", resource.getKeyspace(), permission))
+                                                             .isInstanceOf(org.apache.cassandra.exceptions.UnauthorizedException.class);
+                                                         }
+                                                         else
+                                                         {
+                                                             if (permittedTbls.contains(resource.getKeyspace() + '.' + resource.getTable()))
+                                                                 state.hasAccess(resource.getKeyspace(), permission, resource);
+                                                             else
+                                                             {
+                                                                 assertThatThrownBy(() -> state.hasAccess(resource.getKeyspace(), permission, resource),
+                                                                                    String.format("Expected error for %s on %s", resource.getKeyspace(), permission))
+                                                                 .isInstanceOf(org.apache.cassandra.exceptions.UnauthorizedException.class);
+                                                             }
+                                                         }
+                                                     }
+                                                 }
+                                             }
+                                         }
+                                     }
+
+                                     return null;
+                                 }, systemTables, permittedKeyspaces, permittedTables, levels);
+    }
+
+    private Map<String, Set<String>> getSystemTables(IInvokableInstance instance)
+    {
+        return instance.callOnInstance((IIsolatedExecutor.SerializableCallable<Map<String, Set<String>>>) () -> {
+            Map<String, Set<String>> systemTables = new HashMap<>();
+
+            Set<String> keyspaces = new HashSet<>(SchemaConstants.ALL_SYSTEM_KEYSPACES);
+
+            for (String systemKeyspace : keyspaces)
+            {
+                systemTables.put(systemKeyspace, new HashSet<>());
+                for (ColumnFamilyStore systemCfs : Keyspace.open(systemKeyspace).getColumnFamilyStores())
+                    systemTables.get(systemKeyspace).add(systemCfs.getTableName());
+            }
+
+            return systemTables;
+        });
+    }
+
+    private void doWithSession(Consumer<Session> consumer)
+    {
+        com.datastax.driver.core.Cluster.Builder builder = com.datastax.driver.core.Cluster.builder()
+                                                                                           .withLoadBalancingPolicy(new DCAwareRoundRobinPolicy.Builder().withLocalDc("datacenter1").build())
+                                                                                           .withAuthProvider(new PlainTextAuthProvider("cassandra", "cassandra"))
+                                                                                           .addContactPoint("127.0.0.1");
+
+        try (com.datastax.driver.core.Cluster c = builder.build(); Session session = c.connect())
+        {
+            consumer.accept(session);
+        }
+    }
+
+    private void waitFor(Callable<Boolean> action) throws Throwable
+    {
+        for (int i = 0; i < 10; i++)
+        {
+            if (action.call())
+                break;
+
+            Thread.sleep(1000);
+        }
+    }
+}
